{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "env": {
        "NODE_OPTIONS": "--inspect-brk"
      },
      "serverReadyAction": {
        "pattern": "Local:\\s*(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**", "**.next**"],
      "sourceMapPathOverrides": {
        "turbopack:///[project]/*": "${workspaceFolder}/*"
      }
    }
  ]
}
